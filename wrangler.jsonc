{
  "name": "wordward-game",
  "main": "worker/index.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      "name": "REGISTER_LIMIT",
      "namespace_id": "placeholder-1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "LOGIN_IP_LIMIT",
      "namespace_id": "placeholder-1002",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "LOGIN_USER_LIMIT",
      "namespace_id": "placeholder-1003",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "MERIT_LIMIT",
      "namespace_id": "placeholder-1004",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wordward-preview",
          "database_id": "replace-with-preview-database-id"
        }
      ],
      "ratelimits": [
        { "name": "REGISTER_LIMIT", "namespace_id": "placeholder-2001", "simple": { "limit": 10, "period": 60 } },
        { "name": "LOGIN_IP_LIMIT", "namespace_id": "placeholder-2002", "simple": { "limit": 20, "period": 60 } },
        { "name": "LOGIN_USER_LIMIT", "namespace_id": "placeholder-2003", "simple": { "limit": 10, "period": 60 } },
        { "name": "MERIT_LIMIT", "namespace_id": "placeholder-2004", "simple": { "limit": 30, "period": 60 } }
      ]
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wordward-production",
          "database_id": "replace-with-production-database-id"
        }
      ],
      "ratelimits": [
        { "name": "REGISTER_LIMIT", "namespace_id": "placeholder-3001", "simple": { "limit": 10, "period": 60 } },
        { "name": "LOGIN_IP_LIMIT", "namespace_id": "placeholder-3002", "simple": { "limit": 20, "period": 60 } },
        { "name": "LOGIN_USER_LIMIT", "namespace_id": "placeholder-3003", "simple": { "limit": 10, "period": 60 } },
        { "name": "MERIT_LIMIT", "namespace_id": "placeholder-3004", "simple": { "limit": 30, "period": 60 } }
      ]
    }
  }
}
